{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bukuapay",
  "compatibility_date": "2026-04-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buku3",
      "database_id": "72599521-1e9d-487a-a831-62e74ca91d78"
    }
  ]
}
